<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET für HTTP zum Tiiny (und zur Websuche, ab 0.4),
         ACCESS_NETWORK_STATE für die Wahl des Netzwegs (USB vs. System).
         Kein Zugriff auf den gesamten Speicher: Der Projektordner wird
         ausschliesslich über die Android-Ordnerauswahl (SAF) freigegeben. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17: Zugriff auf das lokale Netz (Tiiny per USB oder WLAN) ist eine
         Laufzeitberechtigung; ohne sie laufen Verbindungen in eine Zeitüberschreitung. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- 1.0: keep running answers alive when the screen locks or the user switches apps.
         Foreground service of type dataSync (only while a request runs), a visible notification
         and a time-limited partial wake lock. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android TV: the app is usable with a remote only (no touchscreen) and runs on phones too,
         so leanback is optional. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- 0.4: Standardbrowser ermitteln (Suchmaschine "Automatic"). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".NisabaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nisaba">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".background.AnswerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
